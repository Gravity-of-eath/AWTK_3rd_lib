+ */
+void ogre_awtk_deinit(void* app_ptr);
+
+/**
+ * 兼容旧接口：render_frame + blit_to_fbo。
+ */
+int ogre_awtk_render_to_fbo(void* app_ptr, unsigned int fbo_id, int w, int h);
